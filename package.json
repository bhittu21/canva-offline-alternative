{
  "name": "design-studio",
  "productName": "Design Studio",
  "version": "1.0.0",
  "private": true,
  "description": "Design Studio: a free, offline design app for Windows. A private Canva alternative with 1,408 templates, no login and optional AI.",
  "author": "Abir",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/check-deps.cjs && install-electron && electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/check-deps.cjs && install-electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "postinstall": "install-electron",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "fflate": "^0.8.3",
    "immer": "^11.2.9",
    "konva": "^10.9.0",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "lucide-static": "^1.61.0",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "com.design-studio.app",
    "productName": "Design Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Design Studio",
      "artifactName": "Design-Studio-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "odesign",
        "name": "Design Studio project",
        "description": "Design Studio design",
        "role": "Editor"
      }
    ]
  }
}
